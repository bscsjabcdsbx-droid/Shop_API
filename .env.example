# Thông tin tài khoản Admin mẫu
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database
DATABASE_URL=

# JWT
JWT_SECRET=

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# CORS: một hoặc nhiều origin của frontend, cách nhau dấu phẩy; "*." cho domain preview của Cloudflare Pages.
# Ví dụ: CLIENT_ORIGIN=https://shop-9be.pages.dev,https://*.shop-9be.pages.dev
# Số lớp proxy phía trước backend (Render = 1)
TRUST_PROXY=1

# ===== Thử đồ AI (CatVTON) =====
# URL công khai của CatVTON API (Quick Tunnel: https://xxxx.trycloudflare.com — đổi mỗi lần chạy lại tunnel).
# Để trống = tắt tính năng (website vẫn chạy bình thường).
CATVTON_API_URL=
# Khóa dùng chung với CatVTON (phải GIỐNG HỆT CATVTON_API_KEY trong .env của CatVTON-AI). >= 24 ký tự.
CATVTON_API_KEY=
# Chỉ điền khi đã chuyển sang Named Tunnel + Cloudflare Access (Service Token). Quick Tunnel: để trống.
CATVTON_ACCESS_CLIENT_ID=
CATVTON_ACCESS_CLIENT_SECRET=
# Timeout (ms) cho MỖI lần gọi HTTP tới CatVTON. Inference chạy bất đồng bộ nên không cần 180000.
CATVTON_API_TIMEOUT=30000
# Đặt false để tắt tạm tính năng mà không cần xóa URL
TRYON_ENABLED=true

# Giới hạn lượt thử đồ (kiểm tra ở backend)
TRYON_USER_MAX_ACTIVE_JOBS=1
# phút
TRYON_RATE_LIMIT_WINDOW=10
TRYON_RATE_LIMIT_MAX=3
TRYON_DAILY_LIMIT=10
# Số request API thử đồ (kể cả kiểm tra trạng thái) tối đa mỗi phút cho một tài khoản
TRYON_REQUESTS_PER_MINUTE=60
# Giây; nên giống MAX_JOB_TIMEOUT của CatVTON
MAX_JOB_TIMEOUT=180
# Giây; job chưa xong sau thời gian này (kể cả thời gian chờ hàng đợi) bị đánh dấu hết thời gian
TRYON_JOB_MAX_AGE=1200
# Giây; ảnh kết quả còn lấy được trong bao lâu (nên giống TRYON_RESULT_TTL của CatVTON)
TRYON_RESULT_TTL=3600
# Byte; dung lượng tối đa ảnh tải lên
TRYON_UPLOAD_MAX_SIZE=10485760
# Giờ giữ metadata TryOnJob (>= 24). Không có ảnh nào trong database.
TRYON_JOB_RETENTION_HOURS=48
# Giây giữa các lần dọn dẹp job
TRYON_CLEANUP_INTERVAL=60

# Danh mục -> loại trang phục CatVTON (slug:upper|lower|overall). Danh mục không có ở đây = không hỗ trợ
# (có thể ghi đè từng sản phẩm trong trang admin, ví dụ chân váy = lower).
TRYON_CATEGORY_MAP=ao:upper,khoac:upper,quan:lower,vay:overall
# Host ngoài được phép tải ảnh sản phẩm (nếu ảnh sản phẩm là URL https://...). Ví dụ: res.cloudinary.com
TRYON_GARMENT_ALLOWED_HOSTS=
# URL công khai của backend này (để nhận ra ảnh /api/uploads/:id lưu dạng URL đầy đủ)
PUBLIC_API_BASE_URL=
